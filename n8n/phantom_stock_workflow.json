{
  "name": "PhantomStock AI - Automated Daily Detection & Manager Alert Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "name": "Daily Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {},
      "name": "Manual Execution Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 480]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/status",
        "options": {}
      },
      "name": "Check Dataset Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 380]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://localhost:8000/api/alerts?date=' + $json.available_dates[$json.available_dates.length - 1] + '&store_id=STORE_001&limit=20' }}",
        "options": {}
      },
      "name": "Fetch Top 20 Alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "item_count_check",
              "leftValue": "={{ $json.length }}",
              "rightValue": 20,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Validate Top-20 Rule",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 380]
    },
    {
      "parameters": {
        "content": "## Phantom Stock Alerts Ready\nStore managers receive maximum 20 verified items to inspect today.",
        "height": 80,
        "width": 240
      },
      "name": "Success Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1250, 280]
    }
  ],
  "connections": {
    "Daily Schedule Trigger": {
      "main": [
        [
          {
            "node": "Check Dataset Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Execution Trigger": {
      "main": [
        [
          {
            "node": "Check Dataset Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Dataset Status": {
      "main": [
        [
          {
            "node": "Fetch Top 20 Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Top 20 Alerts": {
      "main": [
        [
          {
            "node": "Validate Top-20 Rule",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
